# Copy to .env and fill in. core/env.py is the ONLY module that reads this file.
# core.env.bind_tastytrade_client() repoints the vendored client's ENV_PATH at
# this file's absolute path before any token refresh happens, so rotation
# cannot depend on where a script was launched from. See docs/ARCHITECTURE.md
# and CLAUDE.md "Credentials".

# --- TastyTrade OAuth (required for chains, quotes) --------------------------
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# --- massive.com (required for the intraday archive) -------------------------
MASSIVE_API_KEY=

# --- FRED (optional -- falls back to app.risk_free_rate_fallback) ------------
FRED_API_KEY=
